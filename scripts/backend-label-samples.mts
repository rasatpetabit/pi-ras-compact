/** Deterministic plain-text snapshots of real extension renderers, not a feature host-box claim. */
process.env.JEV_TELEMETRY_SOURCE ??= 'eval'; // an eval harness: its ledger rows are source=eval and never land in the live directory
import { writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { stripTerminalSequences } from '@earendil-works/pi-tui';
import { renderCompactionBox, renderMarker, renderCompactionPresentation } from '../src/pi/marker.js';
import { outcomeLine } from '../src/pi/presentation.js';
import { sampleCards, sampleOutcomes } from '../test/support/backend-label-fixtures.js';

const plain = { fg: (_: string, text: string) => text, bold: (text: string) => text };
export function backendLabelSamples(): string {
  const lines = [
    'Generated by: node --import tsx scripts/backend-label-samples.mts',
    'Scope: real extension box child and no-hook marker; not the complete installed Pi box.',
    'Replacement snapshots are complete successful collapsed output under host-api-spec-r3; installed Pi remains additive (8 box rows).',
    'One-line samples use the production 49-cell budget: fits installed notify/title/status at 60 columns, including chrome/countdown.',
    'Expanded metadata only; Pi retains the saved summary body beneath it.',
  ];
  for (const width of [100, 60]) {
    for (const [state, data] of Object.entries(sampleCards())) for (const expanded of [false, true]) {
      for (const kind of ['box child', 'plain marker'] as const) {
        lines.push('', `=== ${state} | ${kind} | ${expanded ? 'expanded' : 'collapsed'} | ${width} columns ===`);
        const component = kind === 'box child' ? renderCompactionBox(data, { expanded }, plain) : renderMarker({ data }, { expanded }, plain);
        lines.push(...component.render(width).map(stripTerminalSequences));
      }
    }
    for (const [state, data] of Object.entries(sampleCards())) {
      const replacement = renderCompactionPresentation(data, { expanded: false, supportsCollapsedReplacement: true, expandHint: 'ctrl+o to expand' }, plain);
      if ('kind' in replacement) lines.push('', `=== ${state} | complete replacement | collapsed | ${width} columns ===`, ...replacement.component.render(width));
    }
    for (const { state, route, explanation } of sampleOutcomes()) {
      lines.push('', `=== ${state} | ${route.backend ?? 'backend not recorded'} | ${width} terminal columns | production budget ===`,
        outcomeLine(state, route, undefined, explanation));
    }
  }
  return lines.join('\n') + '\n';
}
if (process.argv[1] === fileURLToPath(import.meta.url)) {
  writeFileSync(new URL('../docs/backend-label-samples.txt', import.meta.url), backendLabelSamples());
}
